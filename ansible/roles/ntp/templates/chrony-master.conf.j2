# Upstream public servers
pool pool.ntp.org iburst

# Cross-peering between the 3 master nodes
{% for host in groups['master_nodes'] %}
{% if hostvars[host]['ansible_host'] != ansible_host %}
peer {{ hostvars[host]['ansible_host'] }} iburst
{% endif %}
{% endfor %}

# Record rate at which the system clock gains/losses time
driftfile /var/lib/chrony/chrony.drift

# Step the clock quickly if offset is larger than 1 second (essential for cold boots)
makestep 1 3

# Enable kernel synchronization of the real-time clock (RTC)
rtcsync

# Allow local subnet to query this NTP server
allow {{ cluster_subnet }}

# Serve local time even if public internet is temporarily unavailable
local stratum 10

# Logging
logdir /var/log/chrony
log measurements statistics tracking